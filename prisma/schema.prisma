generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
}

enum ShowSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum HoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentEventOutcome {
  SUCCEEDED
  FAILED
}

enum PaymentEventStatus {
  PROCESSED
  IGNORED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum RefundStatus {
  SUCCEEDED
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  roles         UserRole[]     @default([CUSTOMER])
  refreshTokens RefreshToken[]
  organizer     Organizer?
  holds         Hold[]
  bookings      Booking[]
  paymentIntents PaymentIntent[]
  idempotencyKeys IdempotencyKey[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Organizer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venues      Venue[]
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizers")
}

model Venue {
  id          String         @id @default(uuid()) @db.Uuid
  organizerId String         @db.Uuid
  name        String
  city        String
  address     String
  timezone    String         @default("Asia/Kolkata")
  organizer   Organizer      @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  sections    VenueSection[]
  shows       Show[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([organizerId, name, city])
  @@index([city, name])
  @@map("venues")
}

model VenueSection {
  id         String      @id @default(uuid()) @db.Uuid
  venueId    String      @db.Uuid
  name       String
  sortOrder  Int         @default(0)
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats      Seat[]
  showPrices ShowPrice[]

  @@unique([venueId, name])
  @@index([venueId, sortOrder])
  @@map("venue_sections")
}

model Seat {
  id         String       @id @default(uuid()) @db.Uuid
  sectionId  String       @db.Uuid
  rowLabel   String
  seatNumber String
  category   String
  section    VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  showSeats  ShowSeat[]

  @@unique([sectionId, rowLabel, seatNumber])
  @@index([sectionId, category])
  @@map("seats")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  organizerId String      @db.Uuid
  title       String
  description String?
  category    String
  status      EventStatus @default(DRAFT)
  organizer   Organizer   @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  shows       Show[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, category, title])
  @@index([organizerId, createdAt])
  @@map("events")
}

model Show {
  id        String      @id @default(uuid()) @db.Uuid
  eventId   String      @db.Uuid
  venueId   String      @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  currency  String      @default("INR") @db.VarChar(3)
  status    ShowStatus  @default(SCHEDULED)
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  venue     Venue       @relation(fields: [venueId], references: [id], onDelete: Restrict)
  prices    ShowPrice[]
  showSeats ShowSeat[]
  holds     Hold[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([eventId, venueId, startsAt])
  @@index([startsAt, status])
  @@index([venueId, startsAt])
  @@map("shows")
}

model ShowPrice {
  id           String       @id @default(uuid()) @db.Uuid
  showId       String       @db.Uuid
  sectionId    String       @db.Uuid
  seatCategory String
  priceMinor   Int
  show         Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  section      VenueSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  showSeats    ShowSeat[]

  @@unique([showId, sectionId, seatCategory])
  @@index([sectionId])
  @@map("show_prices")
}

model ShowSeat {
  id            String         @id @default(uuid()) @db.Uuid
  showId        String         @db.Uuid
  seatId        String         @db.Uuid
  showPriceId   String         @db.Uuid
  status        ShowSeatStatus @default(AVAILABLE)
  activeHoldId  String?        @db.Uuid
  holdExpiresAt DateTime?
  show           Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat           Seat          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  showPrice      ShowPrice     @relation(fields: [showPriceId], references: [id], onDelete: Restrict)
  activeHold     Hold?         @relation("ActiveHoldSeats", fields: [activeHoldId], references: [id], onDelete: SetNull)
  holdSeats      HoldSeat[]
  bookingSeats   BookingSeat[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([showPriceId])
  @@index([status, holdExpiresAt])
  @@index([activeHoldId])
  @@map("show_seats")
}

model Hold {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  showId      String     @db.Uuid
  status      HoldStatus @default(ACTIVE)
  expiresAt   DateTime
  releasedAt  DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  show        Show       @relation(fields: [showId], references: [id], onDelete: Restrict)
  seats       HoldSeat[]
  activeShowSeats ShowSeat[] @relation("ActiveHoldSeats")
  paymentIntents PaymentIntent[]
  booking     Booking?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("holds")
}

model HoldSeat {
  id          String   @id @default(uuid()) @db.Uuid
  holdId      String   @db.Uuid
  showSeatId  String   @db.Uuid
  priceMinor  Int
  currency    String   @db.VarChar(3)
  hold        Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  showSeat    ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)

  @@unique([holdId, showSeatId])
  @@index([showSeatId])
  @@map("hold_seats")
}

model PaymentIntent {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  holdId         String              @db.Uuid
  amountMinor    Int
  currency       String              @db.VarChar(3)
  status         PaymentIntentStatus @default(PENDING)
  failureReason  String?
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  hold           Hold                @relation(fields: [holdId], references: [id], onDelete: Restrict)
  events         PaymentEvent[]
  booking        Booking?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([holdId, status])
  @@map("payment_intents")
}

model PaymentEvent {
  id               String               @id @default(uuid()) @db.Uuid
  providerEventId  String               @unique
  paymentIntentId  String               @db.Uuid
  outcome          PaymentEventOutcome
  status           PaymentEventStatus
  occurredAt       DateTime
  response         Json
  paymentIntent    PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())

  @@index([paymentIntentId, createdAt])
  @@map("payment_events")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  holdId           String        @unique @db.Uuid
  paymentIntentId  String        @unique @db.Uuid
  status           BookingStatus @default(CONFIRMED)
  totalMinor       Int
  currency         String        @db.VarChar(3)
  cancelledAt      DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  hold             Hold          @relation(fields: [holdId], references: [id], onDelete: Restrict)
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  seats            BookingSeat[]
  refund           Refund?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, createdAt])
  @@map("bookings")
}

model BookingSeat {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  showSeatId  String   @db.Uuid
  priceMinor  Int
  currency    String   @db.VarChar(3)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat    ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
  @@map("booking_seats")
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  bookingId   String       @unique @db.Uuid
  amountMinor Int
  currency    String       @db.VarChar(3)
  status      RefundStatus
  refundedAt  DateTime?
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("refunds")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  scope       String
  key         String
  requestHash String
  response    Json
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model RefreshToken {
  id        String    @id @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
