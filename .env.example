NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://seatforge:seatforge@localhost:5432/seatforge?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
HOLD_TTL_SECONDS=300
HOLD_EXPIRY_INTERVAL_MS=5000
RABBITMQ_URL=amqp://seatforge:seatforge@localhost:5672?heartbeat=10
RABBITMQ_TIMEOUT_MS=5000
WORKER_PREFETCH=10
WORKER_BATCH_SIZE=50
WORKER_RECONNECT_MS=5000
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
RECONCILIATION_INTERVAL_MS=30000
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT_MS=500
CATALOG_CACHE_TTL_SECONDS=15
RATE_LIMIT_AUTH=20
RATE_LIMIT_HOLDS=30
RATE_LIMIT_SEATS=120
RATE_LIMIT_CATALOG=120
# Keep 0 when the API is directly reachable. Compose sets 1 behind Nginx.
TRUST_PROXY_HOPS=0
DB_POOL_MAX=10
# Use 9465 for a worker running alongside the API on the same host.
OPERATIONS_PORT=9464
# Leave the endpoint unset to disable tracing outside Compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=seatforge-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
